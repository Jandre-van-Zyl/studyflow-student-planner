{
  "name": "studyflow-student-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "firebase emulators:exec --project demo-studyflow --only auth,firestore --ui \"npm run dev:emulator\"",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1 --port 5173 --strictPort --open /account",
    "dev:preview": "vite --mode layout --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "build:cloud": "tsc -b && vite build --mode cloud",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:cloud": "vite preview --mode cloud --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-studyflow --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:integration": "firebase emulators:exec --project demo-studyflow --only auth,firestore \"vitest run --config vitest.integration.config.ts\"",
    "emulators": "firebase emulators:start --project demo-studyflow --only auth,firestore",
    "check": "prettier --check . && eslint . && tsc -b && vitest run && vite build"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.34.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "re2@1.27.0": true
  }
}
