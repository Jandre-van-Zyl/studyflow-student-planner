# The UI starts without any Firebase account or these cloud values.
# disabled = UI only; emulator = local demo backend; cloud = explicit shared project.
VITE_FIREBASE_MODE=disabled

# Only used when mode is cloud. Web config is public; never put server credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Emulator mode always uses demo-studyflow on 127.0.0.1, Auth 9099 and Firestore 8080.
# `npm run dev` uses the checked-in public .env.cloud settings and real Firebase.
# `npm run dev:local` starts local Java/Auth emulators and the frontend; `npm test` tests them.
# `npm run dev:preview` forces disabled mode for layout-only work.
# Cloud configuration above is ignored by these explicit local modes.
